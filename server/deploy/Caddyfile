{
    email {$ACME_EMAIL}
    admin off
    default_sni {$API_HOST}
}
{$API_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Cache-Control no-store
    }
    request_body {
        max_size 16KB
    }
    @api path /v1/health /v1/installs /v1/vehicles/lookup
    handle @api {
        reverse_proxy api:8787 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
            transport http {
                response_header_timeout 75s
            }
        }
    }
    handle {
        respond 404
    }
}
