# Образец настроек. Скопируйте в .env (docker compose, npm start) или
# .env.local (npm run dev) и заполните. Оба файла не коммитятся.

# Боевая база — управляемый Postgres в РФ (docs/DATABASES.md). Пусто — PGlite
# в ./data/pglite, только для разработки.
DATABASE_URL=
# Для docker compose: пароль пользователя beepy в контейнере Postgres.
POSTGRES_PASSWORD=

# Админка: логин и хеш пароля. Хеш: npm run hash-password (пароль от 12 знаков).
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Редакция согласия на обработку персональных данных. Меняется вместе с
# текстом согласия в приложении.
# CONSENT_VERSION=2026-10-12

# Поиск по госномеру и оценка цены: токен поставщика живёт только здесь.
# AvtoVinCod предпочтительнее (год выпуска, оценка цены). Пусто — выключено.
AVTOVINCOD_TOKEN=
APICLOUD_TOKEN=
# Лимиты: запросов с одной установки за сутки и найденных (оплаченных) на всех.
# LOOKUP_PER_INSTALL_DAILY=20
# LOOKUP_DAILY_FOUND=100

# PORT=8787
# HOST=127.0.0.1
