{
  "name": "beepy-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Синхронизация поездок Beepy и API админки. Данные — только в Postgres на территории РФ.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "hash-password": "tsx src/hash-password.ts",
    "seed": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@hono/node-server": "1.13.8",
    "hono": "4.6.20",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "typescript": "5.7.3"
  }
}
