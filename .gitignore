# Xcode
DerivedData/
*.xcuserstate
*.xcuserdata/
build/

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
# Package.resolved НЕ игнорируется намеренно. Это пин версий пакетов, а не
# мусор сборки: для приложения (в отличие от библиотеки) его и надо держать
# в git. Пока он был в игноре, состояние SPM жило только на одной машине —
# и переименование папки проекта его потеряло, потому что `git mv` переносит
# только отслеживаемое. Плюс `upToNextMajorVersion 4.0.0` у mapkit-ios: без
# пина повторное разрешение молча подтянет другую 4.x.

# Локальные настройки инструментов
.claude/settings.local.json

# Кэш Python от сервера разбора в tools/
__pycache__/
*.pyc

# Личные заметки из хранилища Obsidian. Синхронизация их и не копирует
# (tools/inbox-sync.sh, LOCAL_DIR), но репозиторий публичный — пусть будет
# вторая застава: случайный `git add -A` не должен вынести их наружу.
inbox/Личное/

# /brag: в git идут план, бриф, композиция и текст поста. Тяжёлое и
# восстановимое — нет: картинки берутся из каталога, музыка и SFX из
# .claude/skills/brag/assets, шрифты и GSAP скачиваются, рендер
# пересобирается командой из brag-output/README.md.
brag-output/composition/assets/
brag-output/composition/vendor/
brag-output/composition/snapshots/
brag-output/composition/node_modules/
brag-output/fonts/
brag-output/*.mp4
brag-output/*.jpg
