<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.canary.inbox-sync</string>

  <!-- Путь к скрипту подставить свой, если репозиторий лежит не здесь. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/Desktop/ios-app/tools/inbox-sync.sh</string>
  </array>

  <!-- Два запуска, и второй не менее важен первого.
       08:45 — отнести заметки за четверть часа до разбора в облаке (09:00).
       09:30 — забрать готовый отчёт обратно в хранилище. Без второго прогона
       отчёт лежал бы на GitHub до следующего утра: на телефоне он появляется
       только после того, как мак сходит за ним.
       Мак спал — launchd запустит сразу после пробуждения. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <!-- И один прогон при входе в систему: мак включают позже 8:45 чаще, чем
       кажется, а заметка, написанная ночью с телефона, нужна утром. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/canary-inbox-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/canary-inbox-sync.log</string>
</dict>
</plist>
